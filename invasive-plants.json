  "plants": [
    {
      "scientificName": "Alliaria petiolata",
      "otherNames": [],
      "commonName": "Garlic mustard",
      "dnrPage": "https://dnr.wisconsin.gov/topic/Invasives/fact/GarlicMustard",
      "category": "restricted",
      "why": "It spreads fast through forests and puts chemicals in the soil that hurt native plants and young trees."
    },
    {
      "scientificName": "Rhamnus cathartica",
      "otherNames": [],
      "commonName": "Common buckthorn",
      "dnrPage": "https://dnr.wisconsin.gov/topic/Invasives/fact/CommonBuckthorn",
      "category": "restricted",
      "why": "It grows into thick thickets that stay green late into fall and shade out wildflowers and young trees."
    },
    {
      "scientificName": "Frangula alnus",
      "otherNames": ["Rhamnus frangula"],
      "commonName": "Glossy buckthorn",
      "dnrPage": "https://dnr.wisconsin.gov/topic/Invasives/fact/GlossyBuckthorn",
      "category": "restricted",
      "why": "It forms thick thickets in wetlands and woods that crowd out native plants."
    },
    {
      "scientificName": "Lythrum salicaria",
      "otherNames": [],
      "commonName": "Purple loosestrife",
      "dnrPage": "https://dnr.wisconsin.gov/topic/Invasives/fact/PurpleLoosestrife",
      "category": "restricted",
      "why": "One plant can make millions of seeds, and it chokes the wetlands that ducks, frogs, and turtles need."
    },
    {
      "scientificName": "Pastinaca sativa",
      "otherNames": [],
      "commonName": "Wild parsnip",
      "dnrPage": "https://dnr.wisconsin.gov/topic/Invasives/fact/WildParsnip",
      "category": "restricted",
      "why": "It takes over roadsides and prairies, and its sap can burn skin when the sun hits it.",
      "warning": "Don't touch! The sap can cause painful burns and blisters in sunlight."
    },
    {
      "scientificName": "Reynoutria japonica",
      "otherNames": ["Fallopia japonica", "Polygonum cuspidatum"],
      "commonName": "Japanese knotweed",
      "dnrPage": "https://dnr.wisconsin.gov/topic/Invasives/fact/JapaneseKnotweed",
      "category": "restricted",
      "why": "It grows so strong it can push up through pavement, and its thick patches crowd out plants along rivers."
    },
    {
      "scientificName": "Lonicera tatarica",
      "otherNames": [],
      "commonName": "Tatarian honeysuckle",
      "dnrPage": "https://dnr.wisconsin.gov/topic/Invasives/fact/TatarianHoneysuckle",
      "category": "restricted",
      "why": "This bush honeysuckle leafs out early in spring and shades out the wildflowers below it."
    },
    {
      "scientificName": "Lonicera morrowii",
      "otherNames": [],
      "commonName": "Morrow's honeysuckle",
      "dnrPage": "https://dnr.wisconsin.gov/topic/Invasives/fact/MorrowsHoneysuckle",
      "category": "restricted",
      "why": "This bush honeysuckle forms dense shrubs that crowd out native plants in woods and fields."
    },
    {
      "scientificName": "Lonicera × bella",
      "otherNames": [],
      "commonName": "Bell's honeysuckle",
      "dnrPage": "https://dnr.wisconsin.gov/topic/Invasives/fact/BellsHoneysuckle",
      "category": "restricted",
      "why": "This bush honeysuckle spreads when birds eat its berries, and it shades out plants on the forest floor."
    },
    {
      "scientificName": "Lonicera maackii",
      "otherNames": [],
      "commonName": "Amur honeysuckle",
      "dnrPage": "https://dnr.wisconsin.gov/topic/Invasives/fact/AmurHoneysuckle",
      "category": "depends-on-county",
